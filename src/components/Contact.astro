---
import { profile } from "../data/site";
import SectionLabel from "./SectionLabel.astro";
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <SectionLabel number="03" title="Contact" id="contact-title" />
  <div class="section-body">
    <p class="contact-statement">{profile.contactStatement}</p>
    <p class="contact-copy">{profile.contactCopy}</p>
    <div class="contact-actions">
      <a class="contact-link" href={`mailto:${profile.email}`}
        >{profile.email}</a
      >
      <a class="text-link" href={profile.github}
        >{profile.githubLabel}<span class="arrow" aria-hidden="true"></span></a
      >
    </div>
  </div>
</section>
