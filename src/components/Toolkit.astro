---
import { education, profile, toolkit, toolkitIntro } from "../data/site";
import SectionLabel from "./SectionLabel.astro";
---

<section class="section" id="toolkit" aria-labelledby="toolkit-title">
  <SectionLabel number="02" title="Toolkit" id="toolkit-title" />
  <div class="section-body">
    <p class="standfirst">{toolkitIntro}</p>
    <dl class="toolkit-list">
      {
        toolkit.map((row) => (
          <div class="toolkit-row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="education">
      <p class="mini-label">Education</p>
      <div>
        <h3>{profile.school}, {profile.location}</h3>
        <p>{education.description}</p>
      </div>
    </div>
  </div>
</section>
