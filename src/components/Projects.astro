---
import { profile, projects, projectsIntro } from "../data/site";
import SectionLabel from "./SectionLabel.astro";
---

<section class="section" id="work" aria-labelledby="work-title">
  <SectionLabel number="01" title="Selected work" id="work-title" />
  <div class="section-body">
    <p class="standfirst">{projectsIntro}</p>
    <ol class="project-list">
      {
        projects.map((project) => (
          <li>
            <a class="project" href={project.href}>
              <span class="project-year">{project.year}</span>
              <div class="project-copy">
                <h3 class="project-title">{project.title}</h3>
                <p class="project-desc">{project.description}</p>
                <p class="project-stack">{project.stack}</p>
              </div>
              <span class="project-link"
                >View code<span class="arrow" aria-hidden="true"></span
              ></span>
            </a>
          </li>
        ))
      }
    </ol>
    <a class="text-link work-more" href={profile.repo}
      >See the full repository<span class="arrow" aria-hidden="true"></span></a
    >
  </div>
</section>
