---
import { getCollection } from "astro:content";
import { journal } from "../data/site";
import { formatDate } from "../lib/format";
import { entryUrl } from "../lib/paths";
import SectionLabel from "./SectionLabel.astro";

const entries = (
  await getCollection("journal", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section class="section" id="journal" aria-labelledby="journal-title">
  <SectionLabel
    number={journal.number}
    title={journal.title}
    id="journal-title"
  />
  <div class="section-body">
    <p class="standfirst">{journal.standfirst}</p>
    {
      entries.length === 0 ? (
        <div class="journal-empty">
          <div>
            <h3 class="journal-empty__title">{journal.emptyTitle}</h3>
            <div class="journal-route" aria-hidden="true"></div>
          </div>
          <div>
            <p class="journal-empty__copy">{journal.emptyCopy}</p>
            <a class="text-link" href={journal.emptyAction.href}
              >{journal.emptyAction.label}</a
            >
          </div>
        </div>
      ) : (
        <ul class="journal-list">
          {entries.map((entry) => (
            <li>
              <a class="journal-entry-link" href={entryUrl(entry.id)}>
                <span class="journal-entry-date">
                  <time datetime={entry.data.date.toISOString()}>
                    {formatDate(entry.data.date)}
                  </time>
                </span>
                <div class="journal-entry-copy">
                  <span class="journal-entry-place">{entry.data.location}</span>
                  <h3 class="journal-entry-title">{entry.data.title}</h3>
                  <p class="journal-entry-desc">{entry.data.description}</p>
                </div>
                <span class="journal-entry-cta">Read entry</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
