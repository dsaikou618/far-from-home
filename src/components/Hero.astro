---
import { profile } from "../data/site";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">Portfolio / 2026</p>
    <h1 id="hero-title">
      {profile.firstName} <span>{profile.lastName}</span>
    </h1>
    <p class="hero-intro">{profile.intro}</p>
    <div class="hero-actions">
      <a class="button-link" href="#work">Selected work</a>
      <a class="text-link" href={profile.github}
        >GitHub<span class="arrow" aria-hidden="true"></span></a
      >
    </div>
  </div>

  <aside class="record-card" aria-label="Student record">
    <div class="record-top">
      <span>Student record</span>
      <span class="record-year">2026</span>
    </div>
    <div class="monogram" aria-hidden="true">{profile.initials}</div>
    <dl class="record-list">
      <div>
        <dt>Based in</dt>
        <dd>{profile.location}</dd>
      </div>
      <div>
        <dt>From</dt>
        <dd>{profile.origin}</dd>
      </div>
      <div>
        <dt>Age</dt>
        <dd>{profile.age}</dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd>{profile.status}</dd>
      </div>
    </dl>
    <div class="route" aria-hidden="true">
      <svg viewBox="0 0 260 56" focusable="false">
        <path
          class="route-path"
          pathLength="1"
          d="M8 40 C 66 4, 194 4, 252 40"></path>
        <circle class="route-dot" cx="8" cy="40" r="3.5"></circle>
        <circle class="route-dot" cx="252" cy="40" r="3.5"></circle>
      </svg>
      <div class="route-labels">
        <span>{profile.origin}</span>
        <span>{profile.location}</span>
      </div>
    </div>
  </aside>
</section>
