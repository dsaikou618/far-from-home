---
import { brand, hero } from "../data/site";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-meta">
    <span>{hero.eyebrow}</span>
    <span>
      {brand.travellers} / {brand.year}
    </span>
  </div>
  <h1 id="hero-title">{hero.title}</h1>
  <div class="hero-bottom">
    <p class="hero-intro">{hero.intro}</p>
    <div class="hero-actions">
      <a class="button-link" href={hero.primary.href}>
        {hero.primary.label}
      </a>
      <a class="text-link" href={hero.secondary.href}>
        {hero.secondary.label}
      </a>
    </div>
  </div>
  <div class="hero-route" aria-hidden="true">
    <svg viewBox="0 0 1200 120" focusable="false">
      <path
        class="route-path"
        pathLength="1"
        d="M2 86 C 180 18, 380 18, 560 60 S 940 104, 1198 34"
      ></path>
      <circle class="route-dot" cx="2" cy="86" r="4"></circle>
      <circle class="route-dot" cx="1198" cy="34" r="4"></circle>
    </svg>
    <div class="route-labels">
      <span>{hero.routeStart}</span>
      <span>{hero.routeEnd}</span>
    </div>
  </div>
</section>
