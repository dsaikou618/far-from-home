---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import Journal from "../components/Journal.astro";
import { brand } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { canonicalUrl } from "../lib/paths";

const title = "Far From Home | Travel journal by Saikou and Tri";
const description =
  "Far From Home is a travel journal by Saikou and Tri. Routes, stops, and notes from the road. The first entries are on the way.";
const canonical = canonicalUrl(Astro.site, Astro.url.origin);
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: brand.name,
  url: canonical,
  description,
  inLanguage: "en",
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Hero />
  <Journal />
  <About />
  <Contact />
</BaseLayout>
